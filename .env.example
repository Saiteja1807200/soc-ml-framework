# ─────────────────────────────────────────────────────────────────
# SOC ML Framework — Environment Variables
# Copy this file to .env and fill in real values before running.
# NEVER commit the real .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Security ────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production-NOW

# ── Database ─────────────────────────────────────────────────────
# SQLite (development — no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./soc_ml_framework.db

# PostgreSQL (production — uncomment and fill in)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/soc_ml_db

# ── Application ──────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=INFO

# ── CORS / Frontend ─────────────────────────────────────────────
# In production, set this to your actual deployed frontend URL
FRONTEND_URL=http://localhost:5173

# ── Docker / PostgreSQL (used by docker-compose) ────────────────
POSTGRES_USER=soc_admin
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=soc_ml_db
